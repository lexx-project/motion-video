{
  "$comment": "Registry metadata for every renderable primitive. Consumed by src/validation to build the Zod schema for element params - unknown primitives fail validation (MASTER_SPEC section 8). param types: string, number, boolean, enum, stringArray, objectArray.",
  "common": {
    "position": {
      "type": "enum",
      "values": [
        "center",
        "left",
        "right",
        "top",
        "bottom",
        "topLeft",
        "topRight",
        "bottomLeft",
        "bottomRight"
      ],
      "default": "center"
    },
    "offsetX": {
      "type": "number",
      "min": -50,
      "max": 50,
      "default": 0
    },
    "offsetY": {
      "type": "number",
      "min": -50,
      "max": 50,
      "default": 0
    },
    "scale": {
      "type": "number",
      "min": 0.2,
      "max": 3,
      "default": 1
    },
    "opacity": {
      "type": "number",
      "min": 0,
      "max": 1,
      "default": 1
    },
    "rotation": {
      "type": "number",
      "min": -360,
      "max": 360,
      "default": 0
    },
    "accent": {
      "type": "enum",
      "values": [
        "none",
        "teal",
        "gold",
        "orange",
        "red"
      ],
      "default": "none"
    },
    "size": {
      "type": "enum",
      "values": [
        "sm",
        "md",
        "lg",
        "xl"
      ],
      "default": "md"
    },
    "variant": {
      "type": "string",
      "max": 32
    },
    "delay": {
      "type": "number",
      "min": 0,
      "max": 60,
      "default": 0
    },
    "entrance": {
      "type": "enum",
      "values": [
        "fade",
        "reveal",
        "slide",
        "scale",
        "draw",
        "stagger"
      ],
      "optional": true
    },
    "emphasis": {
      "type": "enum",
      "values": [
        "subtleScale",
        "positionShift",
        "highlight",
        "glow",
        "counterChange",
        "controlledReveal"
      ],
      "optional": true
    },
    "exit": {
      "type": "enum",
      "values": [
        "fade",
        "slide",
        "dissolve",
        "maskedTransition"
      ],
      "optional": true
    },
    "emphasisAt": {
      "type": "number",
      "min": 0,
      "max": 60,
      "optional": true
    },
    "density": {
      "type": "number",
      "min": 0,
      "max": 1,
      "optional": true
    },
    "role": {
      "type": "enum",
      "values": [
        "semantic",
        "supporting",
        "decorative"
      ],
      "optional": true
    },
    "purpose": {
      "type": "string",
      "max": 140,
      "optional": true
    }
  },
  "primitives": {
    "Headline": {
      "category": "typography",
      "params": {
        "text": {
          "type": "string",
          "required": true,
          "max": 140
        },
        "accentWords": {
          "type": "stringArray",
          "maxItems": 2
        },
        "align": {
          "type": "enum",
          "values": [
            "left",
            "center",
            "right"
          ],
          "default": "left"
        }
      }
    },
    "Subheadline": {
      "category": "typography",
      "params": {
        "text": {
          "type": "string",
          "required": true,
          "max": 200
        },
        "accentWords": {
          "type": "stringArray",
          "maxItems": 2
        },
        "align": {
          "type": "enum",
          "values": [
            "left",
            "center",
            "right"
          ],
          "default": "left"
        }
      }
    },
    "Label": {
      "category": "typography",
      "params": {
        "text": {
          "type": "string",
          "required": true,
          "max": 60
        },
        "align": {
          "type": "enum",
          "values": [
            "left",
            "center",
            "right"
          ],
          "default": "center"
        }
      }
    },
    "Caption": {
      "category": "typography",
      "params": {
        "text": {
          "type": "string",
