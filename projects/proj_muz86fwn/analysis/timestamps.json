  "phrases": [
    {
      "text": "**“Lu tau nggak… salah",
      "start": 0,
      "end": 1.8054446885245903
    },
    {
      "text": "satu hal yang paling",
      "start": 1.8054446885245903,
      "end": 3.6108893770491806
    },
    {
      "text": "bikin capek?”** Berusaha… biar",
      "start": 3.6108893770491806,
      "end": 5.416334065573771
    },
    {
      "text": "semua orang suka sama",
      "start": 5.416334065573771,
      "end": 7.221778754098361
    },
    {
      "text": "kita. Cara ngomong dijaga.",
      "start": 7.221778754098361,
      "end": 9.027223442622951
    },
    {
      "text": "Cara berpakaian dipikirin. Posting",
      "start": 9.027223442622951,
      "end": 10.83266813114754
    },
    {
      "text": "sesuatu… hapus lagi. Takut",
      "start": 10.83266813114754,
      "end": 12.63811281967213
    },
    {
      "text": "ada yang ngejudge. Takut",
      "start": 12.63811281967213,
      "end": 14.44355750819672
    },
    {
      "text": "ada yang ngomongin. Padahal…",
      "start": 14.44355750819672,
      "end": 16.24900219672131
    },
    {
      "text": "**mau lu ngapain juga…",
      "start": 16.24900219672131,
      "end": 18.054446885245902
    },
    {
      "text": "pasti ada aja yang",
      "start": 18.054446885245902,
      "end": 19.859891573770494
    },
    {
      "text": "nggak suka.** Lu baik…",
      "start": 19.859891573770494,
      "end": 21.665336262295085
    },
    {
      "text": "dibilang pencitraan. Lu diem…",
      "start": 21.665336262295085,
      "end": 23.470780950819677
    },
    {
      "text": "dibilang sombong. Lu sukses…",
      "start": 23.470780950819677,
      "end": 25.27622563934427
    },
    {
      "text": "dibilang beruntung. Lu gagal…",
      "start": 25.27622563934427,
      "end": 27.08167032786886
    },
    {
      "text": "ditertawain. Jadi… buat apa?",
      "start": 27.08167032786886,
      "end": 28.88711501639345
    },
    {
      "text": "Lu nggak akan pernah",
      "start": 28.88711501639345,
      "end": 30.692559704918043
    },
    {
      "text": "bisa ngontrol apa yang",
      "start": 30.692559704918043,
      "end": 32.498004393442635
    },
    {
      "text": "orang lain pikirin. Tapi",
      "start": 32.498004393442635,
      "end": 34.30344908196722
    },
    {
      "text": "lu bisa ngontrol… **seberapa",
      "start": 34.30344908196722,
      "end": 36.10889377049181
    },
    {
      "text": "besar pendapat mereka ngaruh",
      "start": 36.10889377049181,
      "end": 37.9143384590164
    },
    {
      "text": "ke hidup lu.** Karena",
      "start": 37.9143384590164,
      "end": 39.71978314754099
    },
    {
      "text": "pada akhirnya… mereka pulang",
      "start": 39.71978314754099,
      "end": 41.525227836065575
    },
    {
      "text": "ke hidup mereka. Dan",
      "start": 41.525227836065575,
      "end": 43.33067252459016
    },
    {
      "text": "lu… **harus tetap hidup",
      "start": 43.33067252459016,
      "end": 45.13611721311475
    },
    {
      "text": "dengan hidup lu sendiri.**",
      "start": 45.13611721311475,
      "end": 46.94156190163934
    },
    {
      "text": "Jadi nggak apa-apa… kalau",
      "start": 46.94156190163934,
      "end": 48.74700659016393
    },
    {
      "text": "nggak semua orang suka",
      "start": 48.74700659016393,
      "end": 50.552451278688515
    },
    {
      "text": "sama lu. **Lu juga",
      "start": 50.552451278688515,
      "end": 52.3578959672131
    },
    {
      "text": "nggak diciptain buat disukai",
      "start": 52.3578959672131,
      "end": 54.16334065573769
    },
    {
      "text": "semua orang.**",
      "start": 54.16334065573769,
      "end": 55.066062999999986
    }
  ]
}