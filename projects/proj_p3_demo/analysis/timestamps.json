{
  "source": "phrase",
  "audioDurationSec": 24.94059,
  "phrases": [
    {
      "text": "Every time you try",
      "start": 0,
      "end": 1.6908874576271187
    },
    {
      "text": "to make everyone happy,",
      "start": 1.6908874576271187,
      "end": 3.3817749152542373
    },
    {
      "text": "you get more tired.",
      "start": 3.3817749152542373,
      "end": 5.072662372881356
    },
    {
      "text": "You change your answer",
      "start": 5.072662372881356,
      "end": 6.763549830508475
    },
    {
      "text": "to match whoever asked.",
      "start": 6.763549830508475,
      "end": 8.454437288135594
    },
    {
      "text": "Your yes stops meaning",
      "start": 8.454437288135594,
      "end": 10.145324745762712
    },
    {
      "text": "anything. Meanwhile the people",
      "start": 10.145324745762712,
      "end": 11.836212203389831
    },
    {
      "text": "who never change their",
      "start": 11.836212203389831,
      "end": 13.52709966101695
    },
    {
      "text": "mind are the ones",
      "start": 13.52709966101695,
      "end": 15.217987118644068
    },
    {
      "text": "others remember. Stop editing",
      "start": 15.217987118644068,
      "end": 16.908874576271188
    },
    {
      "text": "yourself for an audience",
      "start": 16.908874576271188,
      "end": 18.59976203389831
    },
    {
      "text": "that will not applaud",
      "start": 18.59976203389831,
      "end": 20.29064949152543
    },
    {
      "text": "anyway. Your turn to",
      "start": 20.29064949152543,
      "end": 21.98153694915255
    },
    {
      "text": "choose one direction and",
      "start": 21.98153694915255,
      "end": 23.67242440677967
    },
    {
      "text": "stay with it.",
      "start": 23.67242440677967,
      "end": 24.940590000000007
    }
  ]
}